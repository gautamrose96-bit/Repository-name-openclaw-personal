# OpenClaw VPS env file.
# Copy to ~/.openclaw/.env on the server. Fill only what you use.
# The Gateway loads this file automatically on startup.

# --- Telegram (required) ---
# Create a bot with @BotFather (/newbot) and paste the token here.
TELEGRAM_BOT_TOKEN=

# --- Model providers (set at least one) ---
# Groq is the primary model in deploy/vps/openclaw.json. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Gemini is used as a fallback. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Gateway auth (optional) ---
# Leave blank to have OpenClaw auto-generate a token on first start.
# Only needed if you bind beyond loopback or expose the Control UI.
OPENCLAW_GATEWAY_TOKEN=
